# ==============================================================================
# AI Growth Operator Voice OS — Environment Configuration
# ==============================================================================

# AssemblyAI API Key (Required)
# Get yours from https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# DeepSeek API Key (Required for Deep Reasoning & Hermes Content Factory)
# Get yours from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Server Port
PORT=4000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (overrides CLIENT_URL if set).
# Applies to the dashboard and every API route EXCEPT the widget endpoints below.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Origins permitted to embed the widget and mint voice tokens. The widget runs on
# customer sites, so it cannot use CORS_ALLOWED_ORIGINS. Leave unset and ANY site
# may embed it (fine for a demo, warned about at boot); set it in production.
# Example: WIDGET_ALLOWED_ORIGINS=https://customer-a.com,https://customer-b.com
WIDGET_ALLOWED_ORIGINS=

# Max voice-token mints per IP per minute. Each token spends real AssemblyAI
# minutes, and the widget endpoint is reachable by anyone who embeds the script.
VOICE_TOKEN_RATE_LIMIT=20

# Shared-secret bearer key required on credential/publish routes once set.
# Leave unset for local demo mode (routes stay open).
ORCHESTRATOR_API_KEY=

# Same key, exposed to the web build so its fetch calls can send it.
VITE_ORCHESTRATOR_API_KEY=

# Set to true to attempt real Twitter/LinkedIn publish API calls when a
# client has complete OAuth credentials stored. Defaults to simulated.
ENABLE_REAL_PUBLISHING=false

# Redis Cache URL
REDIS_URL=redis://localhost:6379

# Environment (development / production)
NODE_ENV=development
